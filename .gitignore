# smartFind — .gitignore

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
.dart_tool/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# macOS
.DS_Store

# Android
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/key.properties
*.keystore
*.jks

# iOS
ios/Pods/
ios/Symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

# Generated
.dart_tool/
*.g.dart
*.freezed.dart
*.config.dart
# Checked-in generated data the app needs to build (tool/gen-match-data.mjs)
!lib/matching/match_data.g.dart

# Misc
*.log

# smartFind — secrets and tool output (never commit these)
env.json
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
google-services.json
GoogleService-Info.plist

# Cloudflare Worker (server/) and building-calibration output
node_modules/
server/.wrangler/
server/.dev.vars
tool/osm_buildings.json
